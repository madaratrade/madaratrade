<?php
session_start();

require_once __DIR__ . '/db.php';

if (!isset($conn) || !$conn) {
    die("Database connection not initialized.");
}

function h($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function fetchPostsFromApi($username) {
    $result = [
        'posts' => [],
        'postsCount' => 0,
        'apiError' => false
    ];

    if ($username === '') {
        return $result;
    }

    $apiUrl = 'http://127.0.0.1:8000/posts/by-username/' . urlencode($username);

    $context = stream_context_create([
        'http' => [
            'method' => 'GET',
            'timeout' => 5,
            'header' => "Accept: application/json\r\n"
        ]
    ]);

    $response = @file_get_contents($apiUrl, false, $context);

    if ($response === false) {
        $result['apiError'] = true;
        return $result;
    }

    $decoded = json_decode($response, true);

    if (!is_array($decoded)) {
        $result['apiError'] = true;
        return $result;
    }

    $result['posts'] = $decoded;
    $result['postsCount'] = count($decoded);

    return $result;
}

$profileUsername = isset($_GET['username']) ? trim($_GET['username']) : '';
$currentUserId = isset($_SESSION['user_id']) ? (int)$_SESSION['user_id'] : 0;
$currentUsername = isset($_SESSION['username']) ? trim($_SESSION['username']) : '';

if ($profileUsername === '') {
    if ($currentUsername !== '') {
        $profileUsername = $currentUsername;
    } else {
        die('Profile not specified.');
    }
}

$profile = null;

// فیلدهای first_name و last_name در جدول users_account هستند
// فیلد profile_picture در جدول users_info قرار دارد
$sql = "
    SELECT
        ua.id AS user_id,
        ua.username,
        ua.email,
        ua.first_name,
        ua.last_name,
        ui.profile_picture,
        ui.bio,
        ui.instagram_link
    FROM users_account ua
    LEFT JOIN users_info ui ON ui.user_id = ua.id
    WHERE ua.username = ?
    LIMIT 1
";

$stmt = $conn->prepare($sql);
if (!$stmt) {
    die('Prepare failed: ' . $conn->error);
}

$stmt->bind_param('s', $profileUsername);
$stmt->execute();
$result = $stmt->get_result();
$profile = $result->fetch_assoc();
$stmt->close();

if (!$profile) {
    $profile = [
        'user_id' => 0,
        'username' => $profileUsername,
        'email' => '',
        'profile_picture' => '',
        'first_name' => '',
        'last_name' => '',
        'bio' => 'No bio available.',
        'instagram_link' => ''
    ];
}

// تصحیح ساختار عکس پروفایل مطابق aggram
$profile['avatar'] = !empty($profile['profile_picture'])
    ? 'uploads/' . $profile['profile_picture']
    : 'uploads/default-avatar.png';

$profileUserId = (int)$profile['user_id'];
$isOwnProfile = ($currentUserId > 0 && $profileUserId > 0 && $currentUserId === $profileUserId);

$followersCount = 0;
$followingCount = 0;
$isFollowing = false;
$followMessage = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'toggle_follow') {
    if ($currentUserId > 0 && $profileUserId > 0 && !$isOwnProfile) {
        $checkStmt = $conn->prepare("SELECT id FROM follows WHERE follower_id = ? AND following_id = ? LIMIT 1");
        if ($checkStmt) {
            $checkStmt->bind_param('ii', $currentUserId, $profileUserId);
            $checkStmt->execute();
            $checkResult = $checkStmt->get_result();
            $existingFollow = $checkResult->fetch_assoc();
            $checkStmt->close();

            if ($existingFollow) {
                $deleteStmt = $conn->prepare("DELETE FROM follows WHERE id = ?");
                if ($deleteStmt) {
                    $followId = (int)$existingFollow['id'];
                    $deleteStmt->bind_param('i', $followId);
                    $deleteStmt->execute();
                    $deleteStmt->close();
                    $followMessage = 'Unfollowed successfully.';
                }
            } else {
                $insertStmt = $conn->prepare("INSERT INTO follows (follower_id, following_id, created_at) VALUES (?, ?, NOW())");
                if ($insertStmt) {
                    $insertStmt->bind_param('ii', $currentUserId, $profileUserId);
                    $insertStmt->execute();
                    $insertStmt->close();
                    $followMessage = 'Now following this user.';
                }
            }
        }
    }
}

if ($profileUserId > 0) {
    $stmtFollowers = $conn->prepare("SELECT COUNT(*) AS total FROM follows WHERE following_id = ?");
    if ($stmtFollowers) {
        $stmtFollowers->bind_param('i', $profileUserId);
        $stmtFollowers->execute();
        $resultFollowers = $stmtFollowers->get_result();
        $rowFollowers = $resultFollowers->fetch_assoc();
        $followersCount = (int)$rowFollowers['total'];
        $stmtFollowers->close();
    }

    $stmtFollowing = $conn->prepare("SELECT COUNT(*) AS total FROM follows WHERE follower_id = ?");
    if ($stmtFollowing) {
        $stmtFollowing->bind_param('i', $profileUserId);
        $stmtFollowing->execute();
        $resultFollowing = $stmtFollowing->get_result();
        $rowFollowing = $resultFollowing->fetch_assoc();
        $followingCount = (int)$rowFollowing['total'];
        $stmtFollowing->close();
    }

    if ($currentUserId > 0 && !$isOwnProfile) {
        $stmtIsFollowing = $conn->prepare("SELECT COUNT(*) AS total FROM follows WHERE follower_id = ? AND following_id = ?");
        if ($stmtIsFollowing) {
            $stmtIsFollowing->bind_param('ii', $currentUserId, $profileUserId);
            $stmtIsFollowing->execute();
            $resultIsFollowing = $stmtIsFollowing->get_result();
            $rowIsFollowing = $resultIsFollowing->fetch_assoc();
            $isFollowing = ((int)$rowIsFollowing['total']) > 0;
            $stmtIsFollowing->close();
        }
    }
}

$postData = fetchPostsFromApi($profile['username']);
$posts = $postData['posts'];
$postsCount = $postData['postsCount'];
$apiError = $postData['apiError'];

$displayName = trim(($profile['first_name'] ?? '') . ' ' . ($profile['last_name'] ?? ''));
if ($displayName === '') {
    $displayName = $profile['username'];
}

$shareUrl = 'https://madaratrade.com/@' . rawurlencode($profile['username']);
?>
